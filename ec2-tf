# Configure AWS Provider
provider "aws" {
  region = "ap-south-1" # Change to your preferred region
}

data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"] # Official Amazon AMIs
  filter {
    name   = "name"
    values = ["amzn2-ami-hvm-*-x86_64-gp2"]
  }
}

resource "aws_instance" "pathnex" {
  ami                    = "ami-0f559c3642608c138"
  instance_type          = "m7i-flex.large"
  count                  = 1
  key_name               = "Pathnex-ec2-key"
  subnet_id              = "subnet-060e30fbb2ffaa857"
  vpc_security_group_ids = ["sg-006c76c984d9e1309"]
  root_block_device {
  volume_size = 20        # Size in GB
  volume_type = "gp3"     # Recommended (gp2 is legacy)
  delete_on_termination = true
}
  tags = {
    Name = "pathnex-ec2-1"
  }
}

output "ec2_public_ips" {
  value = aws_instance.pathnex[*].public_ip
}



